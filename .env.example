# PolyRouter environment contract
# This file reflects actual runtime usage in the current codebase.

# Required
JWT_SECRET=change-me-to-a-long-random-secret
DATA_DIR=/var/lib/polyrouter

# Recommended runtime variables
PORT=20128
NODE_ENV=production

# Recommended security and ops variables
API_KEY_SECRET=endpoint-proxy-api-key-secret
MACHINE_ID_SALT=endpoint-proxy-salt
ENABLE_REQUEST_LOGS=false
OBSERVABILITY_ENABLED=true
AUTH_COOKIE_SECURE=false
REQUIRE_API_KEY=false

# Cloud sync variables
# Must point to this running instance so internal sync jobs can call /api/sync/cloud.
# Server-side preferred variables:
BASE_URL=http://localhost:20128
CLOUD_URL=https://usepolyrouter.com
# Backward-compatible/public variables:
NEXT_PUBLIC_BASE_URL=http://localhost:20128
NEXT_PUBLIC_CLOUD_URL=https://usepolyrouter.com

# Optional PostHog dashboard analytics. These public browser values track page visits and
# referrers only; sensitive UI text and attributes are masked. Never use this for /v1 API traffic.
# NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Optional Google Analytics 4 browser tracking. This tracks UI page visits only (never /v1 API
# traffic), strips query strings and fragments, and uses cookie_domain=none for localhost support.
# NEXT_PUBLIC_GA_MEASUREMENT_ID=G-8M7E9HNBRK

# Official npm releases can embed a non-secret public endpoint for anonymous lifecycle
# telemetry. It sends only a random local installation UUID, lifecycle event, timestamp, and
# app version—never prompts, requests, models, providers, credentials, passwords, or raw IP.
# Set POLYROUTER_PUBLIC_TELEMETRY=false to opt out before starting PolyRouter. This also
# disables dashboard GA4/PostHog installation identity and explicit dashboard-open analytics.
# PUBLIC_INSTALLATION_TELEMETRY_URL=
# POLYROUTER_PUBLIC_TELEMETRY=true

# Private/self-hosted write-only installation telemetry. This is separate from public telemetry
# and takes precedence when all three values are configured. The app sends an HMAC-hashed login
# IP only in this private mode; never put a Supabase service-role key in the app configuration.
# INSTALLATION_TELEMETRY_URL=
# INSTALLATION_TELEMETRY_INGEST_TOKEN=
# INSTALLATION_TELEMETRY_IP_SALT=

# Cloud sponsors and embedding banners (read-only display data pulled from Supabase via anon
# REST). Both values are required together — without them src/lib/sponsors/remote.js resolves an
# empty key and both features render nothing, silently and by design. The key must be a role:anon
# JWT; RLS restricts it to SELECT on the sponsors and embedding_providers tables. Never put a
# service-role key here. Note that `.env` is excluded from the published npm package
# (cli/scripts/build-cli.js EXCLUDE_PATTERNS), so set these in the host environment.
# SPONSORS_SUPABASE_URL=https://<project-ref>.supabase.co
# SPONSORS_SUPABASE_ANON_KEY=

# First-run security: users must choose a password before dashboard login. INITIAL_PASSWORD
# is no longer used as a runtime fallback.
# INITIAL_PASSWORD=

# Optional outbound proxy variables for upstream provider calls
# Lowercase variants are also supported: http_proxy, https_proxy, all_proxy, no_proxy
# HTTP_PROXY=http://127.0.0.1:7890
# HTTPS_PROXY=http://127.0.0.1:7890
# ALL_PROXY=socks5://127.0.0.1:7890
# NO_PROXY=localhost,127.0.0.1

# Optional SearXNG endpoint for the built-in unauthenticated web-search provider.
# SEARXNG_URL=http://searxng:8080/search

# ── Public tunnel (Dashboard → Endpoint → Enable Tunnel) ──────────────────────
# The tunnel backend registers its rotating URL with a Cloudflare Worker that serves a
# stable shortlink (https://r<shortId>.<worker-domain>), so the public URL never changes.
# TUNNEL_WORKER_URL=https://abc-tunnel.us
#
# Default backend when settings.tunnelProvider is unset: cloudflare | ngrok
# TUNNEL_PROVIDER=cloudflare
#
# ngrok only. Normally set from the dashboard (stored in the local DB); this env var is
# the headless fallback. Get one at https://dashboard.ngrok.com/get-started/your-authtoken
# Requires the optional dep: npm install @ngrok/ngrok
# NGROK_AUTHTOKEN=

# Currently unused by application runtime (kept as reference)
# INSTANCE_NAME=polyrouter
